{
  "name": "llmusage",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=22", "npm": ">=10" },
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run start --workspace frontend",
    "migrate": "npm run migrate --workspace backend",
    "rollup": "npm run rollup --workspace backend --",
    "lint": "eslint . && npm run typecheck --workspace backend",
    "test": "npm test --workspace backend && npm test --workspace frontend",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "angular-eslint": "^20.0.0",
    "eslint": "^9.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0"
  }
}
