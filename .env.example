# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- PostgreSQL (user-provided; PG 18). Use DATABASE_URL, or the PG* variables below instead ---
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/llmusage
# PGHOST=localhost
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=llmusage

# Separate, disposable database used ONLY by backend integration tests (tables are truncated!).
# If unset, integration tests are skipped with a warning.
DATABASE_URL_TEST=postgres://USER:PASSWORD@localhost:5432/llmusage_test

# --- LiteLLM (Docker) ---
# The Anthropic key is NOT set here: enter it in the LiteLLM UI as a credential named `anthropic` (see README).
# Master key LiteLLM requires on every request (also logs you into http://localhost:4000/ui). Choose any long random string.
LITELLM_MASTER_KEY=
# Encrypts credentials stored in LiteLLM's DB. Long random string (e.g. openssl rand -hex 32).
# Set it ONCE and NEVER change it, or the stored Anthropic key becomes unreadable.
LITELLM_SALT_KEY=
# LiteLLM's OWN database (never the app's llmusage DB). Read only by the LiteLLM container, so it is written
# from the container's point of view: host.docker.internal, not localhost. The DB user needs a password.
LITELLM_DATABASE_URL=postgres://USER:PASSWORD@host.docker.internal:5432/litellm
# The backend calls LiteLLM with this key; it must equal LITELLM_MASTER_KEY.
LITELLM_API_KEY=
LITELLM_BASE_URL=http://localhost:4000

# --- Backend ---
# At least 32 characters, e.g. output of: openssl rand -hex 32
JWT_SECRET=
# Admin account created on first start if it does not exist (password min 8 chars)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
PORT=3000
# Set to true to disable the 00:05 IST rollup cron (cron is always off when NODE_ENV=test)
DISABLE_CRON=false
LOG_LEVEL=info
# Model pre-selected in the picker (optional). Must be a model LiteLLM lists; else the first listed model is used.
DEFAULT_MODEL=claude-sonnet-5-5
